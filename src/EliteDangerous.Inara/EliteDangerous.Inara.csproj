<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone, application-agnostic client for the Inara API (https://inara.cz/inara-api-docs/).
    It has NO dependency on EDNexus and no dependency on EliteDangerous.Eddn. The write client
    (InaraClient) is a thin transport: it builds the { header, events } request, POSTs it, and parses
    the response; deciding WHICH events to send and WHEN is the caller's job. The read client
    (InaraReadClient) is deliberately policy-bearing: it adds a caller-supplied consent gate, a
    per-key request limiter, a TTL cache and stale-on-error behaviour, because those protect the
    user and Inara's quota whichever app embeds it. Both stay independently extractable into their
    own repo/package later.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>EliteDangerous.Inara</PackageId>
    <Description>A reusable .NET client for the Inara (inara.cz) commander API.</Description>
    <Authors>Signal &amp; Thread LLC</Authors>
    <Version Condition="'$(Version)' == ''">0.0.1</Version>
  </PropertyGroup>

</Project>
