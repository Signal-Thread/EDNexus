<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EDNexus.App.ViewModels"
        xmlns:controls="clr-namespace:EDNexus.App.Controls"
        xmlns:radio="clr-namespace:EDNexus.Core.Radio;assembly=EDNexus.Core"
        x:Class="EDNexus.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EDNexus — Commander Console"
        Icon="/Assets/ednexus.png"
        Width="980" Height="660" MinWidth="720" MinHeight="480"
        Background="{StaticResource Surface0}">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="8" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- The title doubles as the card's drag handle (see MainWindow.axaml.cs) — hence the hand
         cursor and the tip. Dragging anywhere else would fight the controls on the card. -->
    <Style Selector="TextBlock.cardHeader">
      <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="LetterSpacing" Value="2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip.Tip" Value="Drag by the title to move this card to another column or position" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource InkDim}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.dice">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ToolTip.Tip" Value="Randomize this card" />
    </Style>
    <Style Selector="Button.collapse">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="Foreground" Value="{StaticResource InkDim}" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ToolTip.Tip" Value="Collapse / expand" />
    </Style>
    <Style Selector="Button.devbar">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="{StaticResource SurfaceField}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="{StaticResource AmberBrush}" />
      <Setter Property="Foreground" Value="{StaticResource OnBrand}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.action:disabled">
      <Setter Property="Background" Value="{StaticResource AmberDim}" />
    </Style>
    <Style Selector="Button.mini">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Space Radio: the status badge picks its colour from the playback state, and the LIVE dot
         pulses while audio is actually playing. -->
    <Style Selector="TextBlock.radioStatus">
      <Setter Property="Foreground" Value="{StaticResource InkDim}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.radioStatus.live">
      <Setter Property="Foreground" Value="{StaticResource Good}" />
    </Style>
    <Style Selector="TextBlock.radioStatus.buffering">
      <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
    </Style>
    <Style Selector="TextBlock.radioStatus.error">
      <Setter Property="Foreground" Value="{StaticResource Bad}" />
    </Style>
    <Style Selector="Border.liveDot">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.2" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Surface100}" BorderBrush="{StaticResource CardBorder}"
            BorderThickness="0,0,0,1" Padding="20,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AmberBrush}" />
          <TextBlock Text="EDNEXUS" Foreground="{StaticResource Ink}" FontSize="18"
                     FontWeight="Bold" LetterSpacing="4" VerticalAlignment="Center" />
          <TextBlock Text="COMMANDER CONSOLE" Foreground="{StaticResource InkDim}" FontSize="11"
                     LetterSpacing="3" VerticalAlignment="Center" Margin="4,3,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14"
                    HorizontalAlignment="Right" VerticalAlignment="Center">

          <!-- Compact radio transport: previous / play-pause / next, with the tuned station name
               underneath. Kept in the title bar so it stays reachable from anywhere, the same way the
               physical media keys it'll eventually wire up to (#124) do; the Space Radio card has the
               full player (station picker, volume, mute). Drives the same player as the card: the
               simulation while developer mode is on, tagged SIM. -->
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding RadioTooltip}">
            <Button Command="{Binding RadioPreviousCommand}" Content="⏮" FontSize="13"
                    Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="{StaticResource SurfaceRaised}" Foreground="{StaticResource Ink}" ToolTip.Tip="Previous station" />
            <Button Command="{Binding RadioPlayPauseCommand}" Content="{Binding RadioPlayPauseGlyph}" FontSize="13"
                    Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="{StaticResource SurfaceRaised}" Foreground="{StaticResource AmberBrush}" />
            <Button Command="{Binding RadioNextCommand}" Content="⏭" FontSize="13"
                    Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="{StaticResource SurfaceRaised}" Foreground="{StaticResource Ink}" ToolTip.Tip="Next station" />
            <TextBlock Text="{Binding RadioStationName}" Foreground="{StaticResource InkDim}"
                       FontSize="11" VerticalAlignment="Center" MaxWidth="120"
                       TextTrimming="CharacterEllipsis" Margin="6,0,0,0" />
            <Border IsVisible="{Binding RadioIsSimulated}" Background="{StaticResource AmberChipBg}" CornerRadius="4"
                    Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding RadioSimTooltip}">
              <TextBlock Text="SIM" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                         Foreground="{StaticResource AmberBrush}" />
            </Border>
          </StackPanel>

          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding CommanderName}" Foreground="{StaticResource Ink}"
                       FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding Balance}" Foreground="{StaticResource AmberBrush}"
                       FontSize="13" HorizontalAlignment="Right" />
          </StackPanel>
          <Button Command="{Binding OpenSettingsCommand}" Content="⚙" FontSize="16"
                  Width="36" Height="36" Padding="0" VerticalAlignment="Center"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Background="{StaticResource SurfaceRaised}" Foreground="{StaticResource Ink}" ToolTip.Tip="Settings" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Developer mode action bar -->
    <Border DockPanel.Dock="Top" Background="{StaticResource DevModeBarBg}" BorderBrush="{StaticResource CardBorder}"
            BorderThickness="0,0,0,1" Padding="20,10" IsVisible="{Binding DevMode}">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="DEV MODE" Foreground="{StaticResource AmberBrush}" FontSize="11"
                   FontWeight="SemiBold" LetterSpacing="2" VerticalAlignment="Center" />
        <Button Classes="devbar" Command="{Binding RandomizeAllCommand}" Content="🎲 Randomize all" />
        <Button Classes="devbar" Command="{Binding ResetToLiveCommand}" Content="↺ Reset to live data" />
        <TextBlock Text="Fabricated state is pushed through the real journal pipeline — the 🎲 on each card reshuffles just that card."
                   Classes="label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <!-- Update bar (appears when an update has been downloaded) -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource UpdateBarBg}" BorderBrush="{StaticResource CardBorder}"
            BorderThickness="0,0,0,1" Padding="12" IsVisible="{Binding UpdateAvailable}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="An update was downloaded" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="An update is ready to install" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
          <Button Content="Install" Command="{Binding InstallUpdateCommand}" Classes="action" Margin="8,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer / status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface100}" BorderBrush="{StaticResource CardBorder}"
            BorderThickness="0,1,0,0" Padding="20,8">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding JournalStatus}" Classes="label"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding PrivacyStatus}" Classes="label"
                   Margin="0,0,16,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding LastUpdated, StringFormat='updated {0}'}"
                   Classes="label" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Body: one templated card per CardViewModel, packed into columns. Each card is only as tall
         as its own content — a short card no longer holds a band of dead space under it waiting for
         the tallest card that happened to share its row. Card margins do the spacing, so the panel
         adds none of its own. -->
    <Panel>
    <ScrollViewer>
      <ItemsControl x:Name="CardHost" ItemsSource="{Binding Cards}" Margin="12"
                    DragDrop.AllowDrop="True">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:MasonryPanel MinColumnWidth="468" ColumnSpacing="0" RowSpacing="0" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <!-- Column, span and visibility belong to the container the panel lays out, not to the card
             inside it: a hidden card has to leave no slot behind at all. Scoped to CardHost by name so
             the nested ItemsControls inside cards (material, engineer, market rows…) don't match it. -->
        <ItemsControl.Styles>
          <Style Selector="ItemsControl#CardHost > ContentPresenter" x:DataType="vm:CardViewModel">
            <Setter Property="controls:MasonryPanel.Column" Value="{Binding Column}" />
            <Setter Property="controls:MasonryPanel.ColumnSpan" Value="{Binding ColumnSpan}" />
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
          </Style>
        </ItemsControl.Styles>

        <ItemsControl.DataTemplates>

          <!-- Location -->
          <DataTemplate DataType="vm:LocationCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="dice" Content="🎲" Margin="0,0,6,0"
                          IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DevMode}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RandomizeCardCommand}"
                          CommandParameter="{Binding Id}" />
                  <Button Grid.Column="2" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <TextBlock Classes="big" Text="{Binding SystemName}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <TextBlock Classes="label" Text="Body" />
                    <TextBlock Classes="value" FontSize="13" Text="{Binding Body}" />
                  </StackPanel>
                  <TextBlock Classes="value" FontSize="13" Foreground="{StaticResource AmberBrush}"
                             Text="{Binding LocationStatus}" Margin="0,8,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Ship -->
          <DataTemplate DataType="vm:ShipCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="dice" Content="🎲" Margin="0,0,6,0"
                          IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DevMode}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RandomizeCardCommand}"
                          CommandParameter="{Binding Id}" />
                  <Button Grid.Column="2" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <TextBlock Classes="value" Text="{Binding Ship}" />
                  <TextBlock Classes="label" Text="Fuel" Margin="0,14,0,4" />
                  <Grid ColumnDefinitions="*,Auto">
                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding FuelFraction}"
                                 Height="8" Foreground="{StaticResource AmberBrush}"
                                 Background="{StaticResource SurfaceRaised}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="value" FontSize="13" Margin="12,0,0,0"
                               Text="{Binding Fuel}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Open in Coriolis" Command="{Binding OpenCoriolisBuildCommand}" />
                    <Button Content="Copy link" Margin="8,0,0,0" Command="{Binding CopyCoriolisLinkCommand}" />
                  </StackPanel>
                  <TextBlock Classes="label" Text="{Binding CoriolisStatus}" Margin="0,6,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Materials -->
          <DataTemplate DataType="vm:MaterialsCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="dice" Content="🎲" Margin="0,0,6,0"
                          IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DevMode}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RandomizeCardCommand}"
                          CommandParameter="{Binding Id}" />
                  <Button Grid.Column="2" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <Grid ColumnDefinitions="*,*,*">
                    <StackPanel Grid.Column="0">
                      <TextBlock Classes="big" Text="{Binding RawMaterials}" />
                      <TextBlock Classes="label" Text="Raw" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="big" Text="{Binding ManufacturedMaterials}" />
                      <TextBlock Classes="label" Text="Manufactured" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Classes="big" Text="{Binding EncodedMaterials}" />
                      <TextBlock Classes="label" Text="Encoded" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="label" Text="{Binding MaterialsSummary}" Margin="0,10,0,0" />

                  <!-- Materials at their cap are silently discarding pickups: say so. -->
                  <Border IsVisible="{Binding HasCapWarning}" Background="{StaticResource AmberChipBg}" CornerRadius="4"
                          Padding="8,6" Margin="0,10,0,0">
                    <TextBlock Text="{Binding CapWarning}" Foreground="{StaticResource AmberBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                  </Border>

                  <ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding SelectedCategory}"
                            HorizontalAlignment="Stretch" Margin="0,10,0,6" />

                  <Grid ColumnDefinitions="*,40,110" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Classes="label" Text="MATERIAL" />
                    <TextBlock Grid.Column="1" Classes="label" Text="GR" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Classes="label" Text="HELD / CAP" HorizontalAlignment="Right" />
                  </Grid>

                  <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MaterialStockRow">
                          <Button Background="Transparent" BorderThickness="0" Padding="0,3"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  ToolTip.Tip="{Binding Source}"
                                  Command="{Binding $parent[ItemsControl].((vm:MaterialsCardViewModel)DataContext).SelectMaterialCommand}"
                                  CommandParameter="{Binding Symbol}">
                            <Grid ColumnDefinitions="*,40,110">
                              <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Classes="value" FontSize="13" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="4"
                                             Foreground="{StaticResource AmberDim}" Background="{StaticResource SurfaceRaised}"
                                             Margin="0,3,0,0" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding Grade}" Classes="label" FontSize="12"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding Held}" FontSize="12"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Foreground="{StaticResource Ink}" />
                              <TextBlock Grid.Column="2" Text="FULL" FontSize="10" FontWeight="SemiBold"
                                         IsVisible="{Binding IsFull}" Foreground="{StaticResource Bad}"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <!-- Trader helper for the selected material. -->
                  <StackPanel IsVisible="{Binding HasTrade}" Margin="0,10,0,0">
                    <TextBlock Text="{Binding TradeTitle}" Classes="value" FontSize="13"
                               Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TradeSubtitle}" Classes="label" Margin="0,2,0,6" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,40,70,70">
                      <TextBlock Grid.Column="0" Classes="label" Text="HAND OVER" />
                      <TextBlock Grid.Column="1" Classes="label" Text="GR" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Classes="label" Text="COST" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Classes="label" Text="HAVE" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TradeOptions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TradeOptionRow">
                          <Grid ColumnDefinitions="*,40,70,70" Margin="0,3">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="value" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Grade}" Classes="label" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Cost}" FontSize="12"
                                       Foreground="{StaticResource AmberBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Held}" Classes="label" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Engineering -->
          <DataTemplate DataType="vm:EngineeringCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">

                  <!-- Ship / On-foot toggle -->
                  <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
                    <Button Grid.Column="0" Classes.action="{Binding !OnFootMode}" Classes.mini="{Binding OnFootMode}"
                            Content="SHIP" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding OnFootMode}" Command="{Binding ToggleOnFootModeCommand}" />
                    <Button Grid.Column="1" Classes.action="{Binding OnFootMode}" Classes.mini="{Binding !OnFootMode}"
                            Content="ON-FOOT" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                            Margin="6,0,0,0" IsEnabled="{Binding !OnFootMode}" Command="{Binding ToggleOnFootModeCommand}" />
                  </Grid>

                  <!-- SHIP SIDE -->
                  <StackPanel IsVisible="{Binding !OnFootMode}">

                  <!-- Picker: shown until a blueprint is pinned -->
                  <StackPanel IsVisible="{Binding NoPin}">
                    <TextBlock Classes="label" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Pin one blueprint to focus on. The card then shows where to unlock its engineer and where to farm each material." />
                    <TextBlock Classes="label" Text="BLUEPRINT" />
                    <ComboBox ItemsSource="{Binding Blueprints}" SelectedItem="{Binding SelectedBlueprint}"
                              HorizontalAlignment="Stretch" Margin="0,2,0,8">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BlueprintOption">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                      <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Classes="label" Text="GRADE" />
                        <ComboBox ItemsSource="{Binding GradeChoices}" SelectedItem="{Binding SelectedGrade}"
                                  HorizontalAlignment="Stretch" Margin="0,2,0,0">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:Int32">
                              <TextBlock Text="{Binding StringFormat='Grade {0}'}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="action" Content="Pin goal" VerticalAlignment="Bottom"
                              Command="{Binding PinCommand}" />
                    </Grid>
                  </StackPanel>

                  <!-- Pinned goal -->
                  <StackPanel IsVisible="{Binding HasPin}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0">
                        <TextBlock Classes="value" Text="{Binding PinnedTitle}" FontSize="15" />
                        <TextBlock Classes="label" Text="{Binding PinnedGradeLabel}"
                                   Foreground="{StaticResource AmberBrush}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="mini" Content="Change" VerticalAlignment="Top"
                              Command="{Binding UnpinCommand}" ToolTip.Tip="Unpin and choose a different blueprint" />
                    </Grid>

                    <!-- Engineer -->
                    <Border Background="{StaticResource SurfaceField}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,10,0,10"
                            ToolTip.Tip="{Binding EngineerUnlock}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock Classes="label" Text="ENGINEER" />
                          <TextBlock Text="{Binding EngineerName}" Foreground="{StaticResource Ink}"
                                     FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding EngineerLocation}" Classes="label" FontSize="12" />
                          <TextBlock Text="{Binding EngineerStatus}" FontSize="12" Margin="0,2,0,0"
                                     Foreground="{StaticResource Good}" IsVisible="{Binding EngineerUnlocked}" />
                          <TextBlock Text="{Binding EngineerStatus}" FontSize="12" Margin="0,2,0,0"
                                     Foreground="{StaticResource Bad}" IsVisible="{Binding !EngineerUnlocked}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="mini" Content="Copy system" VerticalAlignment="Center"
                                Command="{Binding CopyEngineerSystemCommand}"
                                ToolTip.Tip="Copy the engineer's system to the clipboard" />
                      </Grid>
                    </Border>

                    <!-- Shopping list: how many rolls to shop for, then held/needed per material. -->
                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,8">
                      <TextBlock Grid.Column="0" Classes="label" Text="ROLLS" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding RollChoices}" Margin="8,0,0,0"
                                SelectedItem="{Binding PlannedRolls}" MinWidth="64"
                                ToolTip.Tip="Shop for this many attempts at the pinned grade" />
                    </Grid>
                    <TextBlock Classes="label" Text="{Binding MaterialsSummary}" Margin="0,0,0,6" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding Materials}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MaterialRow">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4" ToolTip.Tip="{Binding Source}">
                              <Border Grid.Column="0" Background="{StaticResource SurfaceRaised}" CornerRadius="4" Padding="6,2" MinWidth="44"
                                      VerticalAlignment="Top" Margin="0,2,0,0">
                                <TextBlock Text="{Binding CategoryTag}" Foreground="{StaticResource InkDim}"
                                           FontSize="10" HorizontalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Classes="value" FontSize="13" TextWrapping="Wrap" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="4"
                                             Foreground="{StaticResource AmberDim}" Background="{StaticResource SurfaceRaised}"
                                             Margin="0,3,0,0" />
                                <TextBlock Text="{Binding TradeHint}" Classes="label" FontSize="10" Margin="0,2,0,0"
                                           IsVisible="{Binding TradeHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                              <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                  <TextBlock Text="✓" Foreground="{StaticResource Good}" FontSize="13"
                                             IsVisible="{Binding Satisfied}" />
                                  <TextBlock Text="{Binding Held}" Classes="value" FontSize="13"
                                             TextAlignment="Right" />
                                </StackPanel>
                                <TextBlock Text="{Binding Short}" Foreground="{StaticResource Bad}" FontSize="11"
                                           HorizontalAlignment="Right"
                                           IsVisible="{Binding Short, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Classes="label" Text="{Binding OtherEngineers}" TextWrapping="Wrap" Margin="0,8,0,0"
                               IsVisible="{Binding OtherEngineers, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  </StackPanel>
                  <!-- end SHIP SIDE -->

                  <!-- ON-FOOT SIDE -->
                  <StackPanel IsVisible="{Binding OnFootMode}">

                    <!-- Picker: shown until a suit/weapon is pinned -->
                    <StackPanel IsVisible="{Binding OnFootNoPin}">
                      <TextBlock Classes="label" TextWrapping="Wrap" Margin="0,0,0,10"
                                 Text="Pin one suit or weapon grade upgrade. The card shows the cumulative material checklist, credit cost, and any modifications it can then take." />
                      <TextBlock Classes="label" Text="SUIT / WEAPON" />
                      <ComboBox ItemsSource="{Binding OnFootOptions}" SelectedItem="{Binding SelectedOnFootOption}"
                                HorizontalAlignment="Stretch" Margin="0,2,0,8">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:OnFootOption">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                          <TextBlock Classes="label" Text="TARGET GRADE" />
                          <ComboBox ItemsSource="{Binding OnFootGradeChoices}" SelectedItem="{Binding SelectedOnFootGrade}"
                                    HorizontalAlignment="Stretch" Margin="0,2,0,0">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="x:Int32">
                                <TextBlock Text="{Binding StringFormat='Grade {0}'}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="action" Content="Pin goal" VerticalAlignment="Bottom"
                                Command="{Binding PinOnFootCommand}" />
                      </Grid>
                    </StackPanel>

                    <!-- Pinned goal -->
                    <StackPanel IsVisible="{Binding OnFootHasPin}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                          <TextBlock Classes="value" Text="{Binding OnFootPinnedTitle}" FontSize="15" />
                          <TextBlock Classes="label" Text="{Binding OnFootPinnedGradeLabel}"
                                     Foreground="{StaticResource AmberBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="mini" Content="Change" VerticalAlignment="Top"
                                Command="{Binding UnpinOnFootCommand}" ToolTip.Tip="Unpin and choose a different suit/weapon" />
                      </Grid>

                      <TextBlock Classes="label" Text="{Binding OnFootCreditsTotal}" Margin="0,8,0,10"
                                 Foreground="{StaticResource AmberBrush}" FontSize="14" FontWeight="SemiBold" />

                      <!-- Materials -->
                      <TextBlock Classes="label" Text="{Binding OnFootMaterialsSummary}" Margin="0,0,0,6" />
                      <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OnFootMaterials}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OnFootMaterialRow">
                              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4" ToolTip.Tip="{Binding Source}">
                                <Border Grid.Column="0" Background="{StaticResource SurfaceRaised}" CornerRadius="4" Padding="6,2" MinWidth="44">
                                  <TextBlock Text="{Binding CategoryTag}" Foreground="{StaticResource InkDim}"
                                             FontSize="10" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="value" FontSize="13"
                                           Margin="10,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                  <TextBlock Text="✓" Foreground="{StaticResource Good}" FontSize="13"
                                             IsVisible="{Binding Satisfied}" />
                                  <TextBlock Text="{Binding NeededVsHeld}" FontSize="13" MinWidth="60" TextAlignment="Right"
                                             Foreground="{StaticResource Ink}" IsVisible="{Binding Satisfied}" />
                                  <TextBlock Text="{Binding NeededVsHeld}" FontSize="13" MinWidth="60" TextAlignment="Right"
                                             Foreground="{StaticResource Bad}" IsVisible="{Binding !Satisfied}" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>

                      <!-- Modifications -->
                      <TextBlock Classes="label" Text="MODIFICATIONS" Margin="0,10,0,6" />
                      <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OnFootMods}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModRow">
                              <Border Background="{StaticResource SurfaceField}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                      CornerRadius="6" Padding="10,8" Margin="0,4" ToolTip.Tip="{Binding EngineerUnlock}">
                                <StackPanel>
                                  <TextBlock Text="{Binding Name}" Classes="value" FontSize="13" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding Effect}" Classes="label" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4" />
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding EngineerName}" Classes="label" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="Unlocked" FontSize="11" Foreground="{StaticResource Good}"
                                               IsVisible="{Binding EngineerUnlocked}" />
                                    <TextBlock Grid.Column="1" Text="Locked" FontSize="11" Foreground="{StaticResource Bad}"
                                               IsVisible="{Binding !EngineerUnlocked}" />
                                  </Grid>
                                  <TextBlock Text="{Binding EngineerLocation}" Classes="label" FontSize="11" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>
                  </StackPanel>
                  <!-- end ON-FOOT SIDE -->

                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Cargo -->
          <DataTemplate DataType="vm:CargoCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="dice" Content="🎲" Margin="0,0,6,0"
                          IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DevMode}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RandomizeCardCommand}"
                          CommandParameter="{Binding Id}" />
                  <Button Grid.Column="2" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <TextBlock Classes="value" Text="{Binding CargoSummary}" Margin="0,0,0,10" />
                  <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Cargo}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CargoLine">
                          <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                            <Border Grid.Column="0" Background="{StaticResource SurfaceRaised}" CornerRadius="4"
                                    Padding="8,2" MinWidth="44">
                              <TextBlock Text="{Binding Count}" Foreground="{StaticResource AmberBrush}"
                                         FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="value" FontSize="13"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Route plotter -->
          <DataTemplate DataType="vm:RouteCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <TextBlock Classes="label" Text="Plot a route between two systems." TextWrapping="Wrap" Margin="0,0,0,8" />

                  <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                    <RadioButton GroupName="RouteMode" Content="Neutron" IsChecked="{Binding ModeNeutron}" />
                    <RadioButton GroupName="RouteMode" Content="No boost" IsChecked="{Binding ModeNoBoost}" />
                    <RadioButton GroupName="RouteMode" Content="Fleet carrier" IsChecked="{Binding ModeCarrier}" />
                  </StackPanel>
                  <TextBlock Classes="label" Text="{Binding ModeHint}" TextWrapping="Wrap" Margin="0,0,0,10"
                             IsVisible="{Binding ModeHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                  <TextBlock Classes="label" Text="{Binding CarrierFuelText}" TextWrapping="Wrap" Margin="0,0,0,4"
                             Foreground="{StaticResource AmberBrush}"
                             IsVisible="{Binding ShowCarrierFuel}" />
                  <TextBlock Classes="label" Text="{Binding CarrierPendingText}" TextWrapping="Wrap" Margin="0,0,0,10"
                             Foreground="{StaticResource AmberBrush}"
                             IsVisible="{Binding ShowCarrierPending}" />

                  <TextBlock Classes="label" Text="FROM" />
                  <TextBox Classes="field" Text="{Binding RouteFrom}" PlaceholderText="Current system" Margin="0,2,0,8" />
                  <TextBlock Classes="label" Text="TO" />
                  <TextBox Classes="field" Text="{Binding RouteTo}" PlaceholderText="Destination system" Margin="0,2,0,8" />

                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                    <StackPanel Grid.Column="0" Margin="0,0,10,0" IsVisible="{Binding ShowJumpRange}">
                      <TextBlock Classes="label" Text="JUMP RANGE (LY)" />
                      <TextBox Classes="field" Text="{Binding RouteJumpRange}" PlaceholderText="e.g. 48.5" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="mini" Content="Clear" VerticalAlignment="Bottom" Margin="0,0,6,0"
                            Command="{Binding ClearRouteCommand}" ToolTip.Tip="Clear the current route" />
                    <Button Grid.Column="2" Classes="action" Content="Plot route" VerticalAlignment="Bottom"
                            Command="{Binding PlotRouteCommand}" IsEnabled="{Binding !RouteBusy}" />
                  </Grid>

                  <TextBlock Classes="label" Text="{Binding RouteStatus}" TextWrapping="Wrap"
                             IsVisible="{Binding RouteStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                  <StackPanel IsVisible="{Binding RouteHasPlan}" Margin="0,8,0,0">
                    <TextBlock Classes="label" Text="{Binding RouteSummary}" Margin="0,0,0,10" />

                    <Border Background="{StaticResource SurfaceField}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock Classes="label" Text="NEXT SYSTEM" />
                          <TextBlock Text="{Binding RouteNextSystem}" Foreground="{StaticResource AmberBrush}"
                                     FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="mini" Content="◀" Margin="0,0,6,0"
                                Command="{Binding PrevHopCommand}" ToolTip.Tip="Previous hop" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                          <Button Classes="mini" Content="Copy" Command="{Binding CopyNextSystemCommand}"
                                  ToolTip.Tip="Copy the next system to the clipboard" />
                          <Button Classes="mini" Content="Next ▶" Command="{Binding NextHopCommand}" />
                        </StackPanel>
                      </Grid>
                    </Border>

                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding RouteHops}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:RouteHopLine">
                            <Grid ColumnDefinitions="18,*,Auto" Margin="0,4">
                              <TextBlock Grid.Column="0" Text="▸" Foreground="{StaticResource AmberBrush}"
                                         FontWeight="Bold" IsVisible="{Binding IsCurrent}" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1" Margin="2,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding System}" Classes="value" FontSize="13" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding Jumps}" Classes="label" FontSize="11" />
                                  <TextBlock Text="★ neutron" Foreground="{StaticResource Good}" FontSize="11"
                                             IsVisible="{Binding IsNeutron}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Fuel}" Classes="label" FontSize="11" TextWrapping="Wrap"
                                           IsVisible="{Binding ShowFuel}"
                                           Foreground="{StaticResource AmberBrush}" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding Remaining}" Classes="label" FontSize="11"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Trade finder -->
          <DataTemplate DataType="vm:TradeCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <TextBlock Classes="label" Text="Best nearby stations to sell a commodity from your hold — or to source one."
                             TextWrapping="Wrap" Margin="0,0,0,10" />

                  <TextBlock Classes="label" Text="COMMODITY" />
                  <TextBox Classes="field" Text="{Binding TradeCommodity}" PlaceholderText="e.g. Low Temperature Diamonds"
                           Margin="0,2,0,8" />
                  <TextBlock Classes="label" Text="NEAR SYSTEM" />
                  <TextBox Classes="field" Text="{Binding TradeReferenceSystem}" PlaceholderText="Current system" Margin="0,2,0,8" />

                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <CheckBox Grid.Column="0" IsChecked="{Binding TradeSelling}" Foreground="{StaticResource Ink}"
                              Content="Selling (offload hold)" VerticalAlignment="Bottom" />
                    <Button Grid.Column="1" Classes="action" Content="Search" VerticalAlignment="Bottom"
                            Command="{Binding SearchTradeCommand}" IsEnabled="{Binding !TradeBusy}" />
                  </Grid>

                  <TextBlock Classes="label" Text="{Binding TradeStatus}" TextWrapping="Wrap"
                             IsVisible="{Binding TradeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                  <StackPanel IsVisible="{Binding TradeHasResults}" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,90,70,Auto" Margin="0,0,0,2">
                      <TextBlock Grid.Column="0" Classes="label" Text="STATION" />
                      <TextBlock Grid.Column="1" Classes="label" Text="PRICE" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Classes="label" Text="DIST" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Classes="label" Text="" />
                    </Grid>
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding TradeResults}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TradeResultLine">
                            <Grid ColumnDefinitions="*,90,70,Auto" Margin="0,5">
                              <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Station}" Classes="value" FontSize="13" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding System}" Classes="label" FontSize="11" />
                                  <TextBlock Text="{Binding Age}" Classes="label" FontSize="11"
                                             Foreground="{StaticResource InkDim}" />
                                </StackPanel>
                              </StackPanel>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Price}" Foreground="{StaticResource AmberBrush}" FontSize="13"
                                           FontWeight="Medium" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding Quantity}" Classes="label" FontSize="11" HorizontalAlignment="Right" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding Distance}" Classes="value" FontSize="12"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <Button Grid.Column="3" Classes="mini" Content="Copy" Margin="8,0,0,0"
                                      VerticalAlignment="Center" Command="{Binding $parent[ItemsControl].((vm:TradeCardViewModel)DataContext).CopySystemCommand}"
                                      CommandParameter="{Binding System}" ToolTip.Tip="Copy this system" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Colonisation -->
          <DataTemplate DataType="vm:ColonisationCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="dice" Content="🎲" Margin="0,0,6,0"
                          IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DevMode}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RandomizeCardCommand}"
                          CommandParameter="{Binding Id}" />
                  <Button Grid.Column="2" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <TextBlock Classes="label" IsVisible="{Binding NoColonisation}" TextWrapping="Wrap"
                             Text="No construction site in range. Dock at a colonisation construction ship and open its Construction Services panel to load the depot." />

                  <StackPanel IsVisible="{Binding HasColonisation}">
                    <TextBlock Classes="big" Text="{Binding ColonisationTitle}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,4">
                      <ProgressBar Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding ColonisationProgress}"
                                   Height="10" Foreground="{StaticResource AmberBrush}" Background="{StaticResource SurfaceRaised}"
                                   VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="value" FontSize="15" Margin="12,0,0,0"
                                 Text="{Binding ColonisationStatus}" Foreground="{StaticResource AmberBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="label" Text="{Binding ColonisationSummary}" Margin="0,0,0,12" />

                    <!-- Shared totals, when the build is registered on a tracker other commanders
                         also deliver to. Hidden entirely for a solo build, which is most of them. -->
                    <Border IsVisible="{Binding HasShared}" Background="{StaticResource SurfaceField}" CornerRadius="4"
                            Padding="12,10" Margin="0,0,0,12">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock Classes="value" FontSize="13" Text="{Binding SharedTitle}" TextWrapping="Wrap" />
                          <TextBlock Classes="value" FontSize="13" Foreground="{StaticResource AmberBrush}"
                                     Text="{Binding SharedSummary}" TextWrapping="Wrap" />
                          <TextBlock Classes="label" Text="{Binding SharedContributors}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="mini" Content="Refresh" Margin="10,0,0,0"
                                VerticalAlignment="Top" Command="{Binding RefreshSharedCommand}"
                                IsEnabled="{Binding !SharedBusy}"
                                ToolTip.Tip="Re-read the squadron's delivery totals" />
                      </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,110,100,150" Margin="0,0,0,2">
                      <TextBlock Grid.Column="0" Classes="label" Text="COMMODITY" />
                      <TextBlock Grid.Column="1" Classes="label" Text="REMAINING" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Classes="label" Text="TO BUY" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Classes="label" Text="IN HOLD" HorizontalAlignment="Right" />
                    </Grid>

                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding ShoppingList}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ShoppingLine">
                            <Grid ColumnDefinitions="*,110,100,150" Margin="0,5">
                              <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Classes="value" FontSize="13" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="4"
                                             Foreground="{StaticResource AmberDim}" Background="{StaticResource SurfaceRaised}"
                                             Margin="0,4,0,0" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding Remaining}" Classes="value" FontSize="13"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding ToBuy}" Classes="value" FontSize="13"
                                         Foreground="{StaticResource AmberBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="3" Text="{Binding HoldNote}" FontSize="12"
                                         Foreground="{StaticResource Good}" IsVisible="{Binding Carrying}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Market -->
          <DataTemplate DataType="vm:MarketCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="dice" Content="🎲" Margin="0,0,6,0"
                          IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DevMode}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RandomizeCardCommand}"
                          CommandParameter="{Binding Id}" />
                  <Button Grid.Column="2" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <TextBlock Classes="label" IsVisible="{Binding NoMarket}" TextWrapping="Wrap"
                             Text="No market data. Dock at a station and open the Commodities Market to load the board — EDNexus reads it and values your hold here." />

                  <StackPanel IsVisible="{Binding HasMarket}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Classes="big" Text="{Binding MarketTitle}" TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding MarketTitleTip}" />
                        <TextBlock Classes="label" Text="{Binding MarketSummary}" Margin="0,4,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MarketHoldValue}" Foreground="{StaticResource AmberBrush}"
                                   FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Classes="label" Text="hold value here" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>

                    <TextBlock Classes="cardHeader" Text="{Binding MarketListHeader}" Margin="0,16,0,6" />
                    <Grid ColumnDefinitions="*,110,130,150,110" Margin="0,0,0,2">
                      <TextBlock Grid.Column="0" Classes="label" Text="COMMODITY" />
                      <TextBlock Grid.Column="1" Classes="label" Text="QTY" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="2" Classes="label" Text="UNIT" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Classes="label" Text="TOTAL" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="4" Classes="label" Text="VS MEAN" HorizontalAlignment="Right" />
                    </Grid>

                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding MarketRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MarketLine">
                            <Grid ColumnDefinitions="*,110,130,150,110" Margin="0,5">
                              <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="value" FontSize="13"
                                         Margin="0,0,12,0" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Qty}" Classes="value" FontSize="13"
                                         Foreground="{StaticResource InkDim}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding Unit}" Classes="value" FontSize="13"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="3" Text="{Binding Total}" Classes="value" FontSize="13"
                                         Foreground="{StaticResource AmberBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="4" Text="{Binding VsMean}" FontSize="12"
                                         Foreground="{StaticResource Good}" IsVisible="{Binding Good}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="4" Text="{Binding VsMean}" FontSize="12"
                                         Foreground="{StaticResource Bad}" IsVisible="{Binding Bad}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="4" Text="{Binding VsMean}" FontSize="12"
                                         Foreground="{StaticResource InkDim}" IsVisible="{Binding Unknown}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Mining: what a prospected asteroid turned up, with anything above the credit threshold
               called out — deep-core motherlodes separately from the rest of the deposit list, since
               that is the one distinction the journal actually lets EDNexus draw. -->
          <DataTemplate DataType="vm:MiningCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="dice" Content="🎲" Margin="0,0,6,0"
                          IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DevMode}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RandomizeCardCommand}"
                          CommandParameter="{Binding Id}" />
                  <Button Grid.Column="2" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <StackPanel Grid.Column="0">
                      <TextBlock Classes="value" FontSize="13" Text="{Binding TodayValueText}" TextWrapping="Wrap"
                                 IsVisible="{Binding TodayValueText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Classes="label" Text="{Binding LastSessionText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                 IsVisible="{Binding LastSessionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="mini" Content="Clear" VerticalAlignment="Top"
                            Command="{Binding ClearHistoryCommand}" ToolTip.Tip="Clear this session's prospected history" />
                  </Grid>

                  <TextBlock Classes="value" FontSize="13" Text="{Binding LatestSummary}" TextWrapping="Wrap"
                             Foreground="{StaticResource Good}" IsVisible="{Binding LatestWorthMining}" />
                  <TextBlock Classes="label" Text="{Binding LatestSummary}" TextWrapping="Wrap"
                             IsVisible="{Binding !LatestWorthMining}" />
                  <TextBlock Classes="label" Text="{Binding SessionSummary}" Margin="0,2,0,0"
                             IsVisible="{Binding SessionSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                  <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding Prospects}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProspectRow">
                          <Border Background="{StaticResource SurfaceField}" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                  <TextBlock Classes="value" FontSize="12" Foreground="{StaticResource InkDim}" Text="{Binding Time}" />
                                  <TextBlock Classes="label" Text="{Binding ContentLabel}" IsVisible="{Binding ShowContent}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="label" Text="{Binding Remaining}" IsVisible="{Binding ShowRemaining}" />
                              </Grid>

                              <Border Background="{StaticResource AmberChipBg}" CornerRadius="4" Padding="8,6" IsVisible="{Binding HasMotherlode}">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                  <TextBlock Grid.Column="0" Classes="value" FontSize="13" Text="{Binding Motherlode.Name}" />
                                  <TextBlock Grid.Column="1" Classes="label" Text="DEEP CORE" Foreground="{StaticResource AmberBrush}" Margin="8,0" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="2" Classes="value" FontSize="12" Text="{Binding Motherlode.PriceText}"
                                             Foreground="{StaticResource Good}" VerticalAlignment="Center" />
                                </Grid>
                              </Border>

                              <ItemsControl ItemsSource="{Binding Materials}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ProspectMaterialRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                      <TextBlock Grid.Column="0" Classes="value" FontSize="13" Text="{Binding Name}"
                                                 Foreground="{StaticResource Good}" FontWeight="SemiBold" IsVisible="{Binding WorthMining}" />
                                      <TextBlock Grid.Column="0" Classes="value" FontSize="13" Text="{Binding Name}"
                                                 IsVisible="{Binding !WorthMining}" />
                                      <TextBlock Grid.Column="1" Classes="label" Text="{Binding ProportionText}"
                                                 IsVisible="{Binding ShowProportion}" Margin="8,0" VerticalAlignment="Center" />
                                      <TextBlock Grid.Column="2" Classes="value" FontSize="12" Text="{Binding PriceText}"
                                                 Foreground="{StaticResource Good}" IsVisible="{Binding WorthMining}" VerticalAlignment="Center" />
                                      <TextBlock Grid.Column="2" Classes="label" Text="{Binding PriceText}"
                                                 IsVisible="{Binding !WorthMining}" VerticalAlignment="Center" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Exobiology -->
          <DataTemplate DataType="vm:ExobiologyCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="dice" Content="🎲" Margin="0,0,6,0"
                          IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DevMode}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RandomizeCardCommand}"
                          CommandParameter="{Binding Id}" />
                  <Button Grid.Column="2" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <TextBlock Classes="label" IsVisible="{Binding NoExobio}" TextWrapping="Wrap"
                             Text="No biology tracked yet. Scan a system with the FSS, then map a landable body with the DSS to see its bio signals and what they are worth." />

                  <!-- What is on this body. -->
                  <StackPanel IsVisible="{Binding HasBody}">
                    <TextBlock Classes="big" Text="{Binding BodyName}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                      <TextBlock Classes="value" FontSize="13" VerticalAlignment="Center"
                                 Foreground="{StaticResource AmberBrush}" Text="{Binding BodySignals}" />
                      <Border IsVisible="{Binding IsFirstDiscovery}" BorderBrush="{StaticResource AmberBrush}"
                              BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                              ToolTip.Tip="Nobody had scanned this body — first-logged samples pay five times the base">
                        <TextBlock Text="UNDISCOVERED · ×5" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                                   Foreground="{StaticResource AmberBrush}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="label" Text="{Binding BodyGenera}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Classes="value" FontSize="13" Margin="0,4,0,0" Text="{Binding BodyValue}"
                               IsVisible="{Binding BodyValue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Species the body's physics can grow, predicted offline, with their sample distances. -->
                    <StackPanel IsVisible="{Binding HasPredictions}" Margin="0,8,0,0">
                      <TextBlock Classes="label" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                                 Text="{Binding PredictionsHeader}" />
                      <ItemsControl ItemsSource="{Binding PredictedSpecies}" Margin="0,3,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PredictedBioLine">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                              <TextBlock Grid.Column="0" Classes="value" FontSize="12" Text="{Binding Name}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Classes="label" Text="{Binding Distance}" Margin="8,0" />
                              <TextBlock Grid.Column="2" Text="{Binding Payout}" Foreground="{StaticResource AmberBrush}"
                                         FontSize="12" FontWeight="SemiBold" ToolTip.Tip="{Binding PayoutTip}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>

                  <!-- The three-sample run in progress. -->
                  <StackPanel IsVisible="{Binding HasScan}" Margin="0,12,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="value" FontSize="14" Text="{Binding ScanSpecies}"
                                 TextWrapping="Wrap" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="value" FontSize="16" Margin="10,0,0,0"
                                 Foreground="{StaticResource AmberBrush}" Text="{Binding ScanProgress}"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ScanFraction}" Height="8"
                                 Foreground="{StaticResource AmberBrush}" Background="{StaticResource SurfaceRaised}" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                      <TextBlock Grid.Column="0" Classes="label" Text="{Binding ScanValue}" />
                      <TextBlock Grid.Column="1" Classes="label" Margin="10,0,0,0" Text="{Binding ScanDistance}"
                                 Foreground="{StaticResource AmberBrush}"
                                 ToolTip.Tip="Move at least this far from the last sample before taking the next" />
                    </Grid>
                  </StackPanel>

                  <!-- Session tally. -->
                  <Grid ColumnDefinitions="*,*" Margin="0,14,0,0">
                    <StackPanel Grid.Column="0">
                      <TextBlock Classes="big" FontSize="18" Text="{Binding PendingValue}"
                                 Foreground="{StaticResource AmberBrush}" />
                      <TextBlock Classes="label" Text="{Binding PendingSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="big" FontSize="18" Text="{Binding SoldValue}"
                                 Foreground="{StaticResource Good}" />
                      <TextBlock Classes="label" Text="{Binding SoldSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>

                  <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Pending}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BioLine">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                            <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Species}" Classes="value" FontSize="13" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Body}" Classes="label" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Value}" Foreground="{StaticResource AmberBrush}"
                                         FontSize="13" HorizontalAlignment="Right" />
                              <TextBlock Text="{Binding FirstLogged}" Classes="label" FontSize="10"
                                         HorizontalAlignment="Right" ToolTip.Tip="If first logged (×5)" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Engineers: the unlock path, one actionable step each -->
          <DataTemplate DataType="vm:EngineersCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="label" Text="{Binding Summary}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="mini" Command="{Binding ToggleFinishedCommand}"
                            Content="Show all" IsVisible="{Binding HideFinished}"
                            ToolTip.Tip="Include engineers already at grade 5" />
                    <Button Grid.Column="1" Classes="mini" Command="{Binding ToggleFinishedCommand}"
                            Content="Hide done" IsVisible="{Binding !HideFinished}"
                            ToolTip.Tip="Hide engineers already at grade 5" />
                  </Grid>

                  <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Engineers}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EngineerRow">
                          <Border Background="{StaticResource SurfaceField}" CornerRadius="4" Padding="10,8" Margin="0,0,0,6"
                                  ToolTip.Tip="{Binding TopGrades}">
                            <StackPanel>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="value" FontSize="13"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource SurfaceRaised}" CornerRadius="3" Padding="6,2"
                                        VerticalAlignment="Center" MinWidth="56">
                                  <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                             HorizontalAlignment="Center" Foreground="{StaticResource InkDim}" />
                                </Border>
                              </Grid>
                              <TextBlock Text="{Binding Location}" Classes="label" FontSize="11" Margin="0,2,0,0" />
                              <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="4"
                                           Foreground="{StaticResource AmberDim}" Background="{StaticResource SurfaceRaised}"
                                           Margin="0,5,0,0" />
                              <TextBlock Text="{Binding NextStep}" FontSize="11" Margin="0,5,0,0"
                                         TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Missions — the stacks currently held, then where to hand them in. -->
          <DataTemplate DataType="vm:MissionsCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="dice" Content="🎲" Margin="0,0,6,0"
                          IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DevMode}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RandomizeCardCommand}"
                          CommandParameter="{Binding Id}" />
                  <Button Grid.Column="2" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <TextBlock Classes="label" IsVisible="{Binding NoMissions}" TextWrapping="Wrap"
                             Text="No missions held. Take some from a station's mission board — kill missions against the same faction stack, so one fight can clear several at once." />

                  <StackPanel IsVisible="{Binding HasMissions}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="value" FontSize="13" Text="{Binding MissionSummary}"
                                 TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="mini" Content="War Board" Margin="10,0,0,0"
                              Command="{Binding OpenWarBoardCommand}"
                              ToolTip.Tip="Open every held mission in its own window" />
                    </Grid>
                    <TextBlock Classes="label" Text="{Binding CapNote}" Margin="0,2,0,0" />

                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                      <ItemsControl ItemsSource="{Binding Stacks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:StackLine">
                            <Border Background="{StaticResource SurfaceField}" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                              <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock Grid.Column="0" Classes="value" FontSize="14" Text="{Binding Target}"
                                             TextWrapping="Wrap" />
                                  <TextBlock Grid.Column="1" Classes="value" FontSize="13" Margin="10,0,0,0"
                                             Foreground="{StaticResource Good}" Text="{Binding Reward}"
                                             VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Classes="label" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                  <TextBlock Classes="value" FontSize="14" Foreground="{StaticResource AmberBrush}"
                                             Text="{Binding Kills}" />
                                  <TextBlock Classes="label" Text="{Binding KillsNote}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="label" Text="{Binding Givers}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Classes="label" Text="{Binding Logged}" IsVisible="{Binding HasLogged}" />
                                <TextBlock Classes="value" FontSize="12" Foreground="{StaticResource Good}"
                                           Text="{Binding ReadyNote}" IsVisible="{Binding HasReady}" />
                                <TextBlock Classes="value" FontSize="12" Text="{Binding ExpiryNote}"
                                           IsVisible="{Binding HasExpiryNote}"
                                           Foreground="{StaticResource InkDim}" />
                                <TextBlock Classes="value" FontSize="12" Text="{Binding ExpiryNote}"
                                           IsVisible="{Binding IsUrgent}"
                                           Foreground="{StaticResource Bad}" FontWeight="SemiBold" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Classes="label" Text="HAND IN AT" Margin="0,8,0,4" />
                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding TurnIns}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TurnInLine">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                              <StackPanel Grid.Column="0">
                                <TextBlock Classes="value" FontSize="13" Text="{Binding Where}" TextWrapping="Wrap" />
                                <TextBlock Classes="label" Text="{Binding Detail}" />
                                <TextBlock Classes="label" Text="{Binding ExpiryNote}" IsVisible="{Binding HasExpiryNote}"
                                           Foreground="{StaticResource InkDim}" />
                                <TextBlock Classes="label" Text="{Binding ExpiryNote}" IsVisible="{Binding IsUrgent}"
                                           Foreground="{StaticResource Bad}" FontWeight="SemiBold" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Classes="label" Text="{Binding ReadyNote}"
                                         Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Community Goals — every active goal seen nearby: tier reached, contribution vs
               total, current top-tier bonus, and time remaining. -->
          <DataTemplate DataType="vm:CommunityGoalsCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="dice" Content="🎲" Margin="0,0,6,0"
                          IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DevMode}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RandomizeCardCommand}"
                          CommandParameter="{Binding Id}" />
                  <Button Grid.Column="2" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <TextBlock Classes="label" IsVisible="{Binding NoGoals}" TextWrapping="Wrap"
                             Text="No Community Goals nearby. They show up here once one is active at a system you're near, or as soon as you join one from a station's CG board." />

                  <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasGoals}">
                    <ItemsControl ItemsSource="{Binding Goals}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CommunityGoalLine">
                          <Border Background="{StaticResource SurfaceField}" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel Spacing="2">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="value" FontSize="14" Text="{Binding Title}"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Classes="value" FontSize="12" Margin="10,0,0,0"
                                           Foreground="{StaticResource AmberBrush}" Text="{Binding Joined}"
                                           IsVisible="{Binding HasJoined}" VerticalAlignment="Center" />
                              </Grid>
                              <TextBlock Classes="label" Text="{Binding Where}" TextWrapping="Wrap" />
                              <TextBlock Classes="value" FontSize="13" Margin="0,4,0,0" Text="{Binding Tier}"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="label" Text="{Binding Contribution}" TextWrapping="Wrap" />
                              <TextBlock Classes="label" Text="{Binding Rank}" IsVisible="{Binding HasRank}" />
                              <TextBlock Classes="value" FontSize="12" Foreground="{StaticResource Good}"
                                         Text="{Binding TimeNote}" IsVisible="{Binding HasTimeNote}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Ranks — one row per pilot ladder: current rank name and progress to the next tier.
               Elite ranks are picked out in amber and drop the bar, which has nothing left to fill. -->
          <DataTemplate DataType="vm:RanksCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Button Grid.Column="1" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <TextBlock Classes="label" Text="{Binding Summary}" TextWrapping="Wrap" />

                  <ItemsControl ItemsSource="{Binding Ranks}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RankRow">
                        <Border Background="{StaticResource SurfaceField}" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                          <StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="label"
                                         FontSize="11" MinWidth="86" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="value" FontSize="13"
                                         TextWrapping="Wrap" VerticalAlignment="Center"
                                         IsVisible="{Binding !IsElite}" />
                              <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="value" FontSize="13"
                                         TextWrapping="Wrap" VerticalAlignment="Center"
                                         IsVisible="{Binding IsElite}" FontWeight="SemiBold"
                                         Foreground="{StaticResource AmberBrush}" />
                              <TextBlock Grid.Column="2" Text="{Binding Progress}" FontSize="11"
                                         VerticalAlignment="Center" Foreground="{StaticResource InkDim}" />
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" Height="4"
                                         IsVisible="{Binding ShowBar}"
                                         Foreground="{StaticResource AmberDim}" Background="{StaticResource SurfaceRaised}"
                                         Margin="0,5,0,0" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Galnet — a one-line ticker cycling the latest headlines; the whole line opens the
               reader window. No 🎲: the card has no journal sample source, so developer mode swaps
               the whole feed for the offline generator instead. -->
          <DataTemplate DataType="vm:GalnetCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <!-- New-since-last-open count; hidden once every loaded headline has been opened. -->
                  <Border Grid.Column="1" IsVisible="{Binding HasUnread}" Background="{StaticResource AmberBrush}"
                          CornerRadius="8" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UnreadCount}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Surface0}" />
                  </Border>
                  <Button Grid.Column="2" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">
                  <!-- The headline itself is the button: click anywhere on it to read the article. -->
                  <Button Command="{Binding OpenReaderCommand}" IsVisible="{Binding HasTicker}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          ToolTip.Tip="Open this article in the Galnet reader">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding TickerHeadline.Title}" Classes="value"
                                 FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding TickerHeadline.Stamp}" Classes="label"
                                 Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                  </Button>

                  <TextBlock Classes="label" Text="{Binding NewsStatus}" TextWrapping="Wrap"
                             IsVisible="{Binding !HasTicker}" />

                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,0">
                    <Button Grid.Column="0" Classes="mini" Content="‹" MinWidth="28"
                            Command="{Binding PreviousHeadlineCommand}" IsVisible="{Binding HasTicker}"
                            ToolTip.Tip="Previous headline" />
                    <Button Grid.Column="1" Classes="mini" Content="›" MinWidth="28" Margin="4,0,0,0"
                            Command="{Binding NextHeadlineCommand}" IsVisible="{Binding HasTicker}"
                            ToolTip.Tip="Next headline" />
                    <TextBlock Grid.Column="2" Classes="label" Text="{Binding TickerPosition}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Classes="mini" Content="Read all"
                            Command="{Binding OpenReaderCommand}"
                            ToolTip.Tip="Open the Galnet reader in its own window" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

          <!-- Space Radio — the full player: status (pulsing LIVE dot, BUFFERING, OFFLINE with the
               reason), transport, station picker and volume/mute. In developer mode it and the title bar
               drive an in-memory simulation (tagged SIMULATED) that the 🎲 steps through every state; no audio. -->
          <DataTemplate DataType="vm:RadioCardViewModel">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <TextBlock Grid.Column="0" Classes="cardHeader" Text="{Binding Title}" />
                  <Border Grid.Column="1" IsVisible="{Binding IsSimulated}" Background="{StaticResource AmberChipBg}"
                          CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Top"
                          ToolTip.Tip="Developer mode: this card shows a simulated player. No audio plays and nothing is saved.">
                    <TextBlock Text="SIMULATED" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                               Foreground="{StaticResource AmberBrush}" />
                  </Border>
                  <Button Grid.Column="2" Classes="dice" Content="🎲" Margin="0,0,6,0"
                          IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DevMode}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RandomizeCardCommand}"
                          CommandParameter="{Binding Id}" />
                  <Button Grid.Column="3" Classes="collapse" Content="{Binding CollapseGlyph}"
                          Command="{Binding ToggleCollapseCommand}" />
                </Grid>
                <StackPanel IsVisible="{Binding !IsCollapsed}">

                  <!-- Status: badge + the station blurb, the error, or a hint. -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="liveDot" Width="8" Height="8" CornerRadius="4"
                            Background="{StaticResource Bad}" VerticalAlignment="Center"
                            IsVisible="{Binding IsLive}" />
                    <TextBlock Classes="radioStatus" Text="{Binding StatusLabel}"
                               Classes.live="{Binding IsLive}" Classes.buffering="{Binding IsBuffering}"
                               Classes.error="{Binding IsError}" />
                  </StackPanel>
                  <TextBlock Classes="label" Text="{Binding StatusDetail}" TextWrapping="Wrap" Margin="0,4,0,0" />

                  <!-- Transport -->
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
                    <Button Classes="mini" Content="⏮" MinWidth="36" HorizontalContentAlignment="Center"
                            Command="{Binding PreviousStationCommand}" ToolTip.Tip="Previous station" />
                    <Button Classes="action" Content="{Binding PlayPauseGlyph}" MinWidth="52"
                            HorizontalContentAlignment="Center"
                            Command="{Binding PlayPauseCommand}" ToolTip.Tip="{Binding PlayPauseTooltip}" />
                    <Button Classes="mini" Content="⏭" MinWidth="36" HorizontalContentAlignment="Center"
                            Command="{Binding NextStationCommand}" ToolTip.Tip="Next station" />
                  </StackPanel>

                  <!-- Station picker: choosing one tunes to it. -->
                  <TextBlock Classes="label" Text="STATION" Margin="0,12,0,2" />
                  <ComboBox ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                            HorizontalAlignment="Stretch" PlaceholderText="Choose a station">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="radio:RadioStation">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" FontSize="13" />
                          <TextBlock Text="{Binding Description}" Foreground="{StaticResource InkDim}"
                                     FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <!-- Volume + mute -->
                  <TextBlock Classes="label" Text="VOLUME" Margin="0,12,0,2" />
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Classes="mini" Content="{Binding MuteGlyph}" MinWidth="36"
                            HorizontalContentAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding ToggleMuteCommand}" ToolTip.Tip="{Binding MuteTooltip}" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                            IsSnapToTickEnabled="True" Value="{Binding Volume}"
                            Margin="10,0" VerticalAlignment="Center"
                            Foreground="{StaticResource AmberBrush}" />
                    <TextBlock Grid.Column="2" Classes="value" FontSize="13" Text="{Binding VolumeText}"
                               MinWidth="28" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>

        </ItemsControl.DataTemplates>
      </ItemsControl>
    </ScrollViewer>

      <!-- Drop indicator, floated above the cards. It has to sit outside the ScrollViewer so it is
           never clipped by it, and it must not swallow the drag events on their way to the panel. -->
      <Canvas IsHitTestVisible="False">
        <Border x:Name="DropLine" Background="{StaticResource AmberBrush}" CornerRadius="2"
                IsVisible="False" />
      </Canvas>
    </Panel>
  </DockPanel>
</Window>
