<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EDNexus.App.ViewModels"
        xmlns:controls="clr-namespace:EDNexus.App.Controls"
        x:Class="EDNexus.App.Views.SettingsWindow"
        Title="EDNexus — Settings"
        Icon="/Assets/ednexus.png"
        Width="880" SizeToContent="Height"
        MinWidth="380" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        CanResize="True" Background="{StaticResource CardBg}">
  <!-- The dialog auto-sizes to its content but is capped to the display in code-behind, so the body
       scrolls rather than running off the bottom of a short screen. The action row is docked so
       Save/Close stay reachable however far the body has scrolled. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="Open logs" Click="OnOpenLogs" Padding="16,8" />
        <Button Content="Close" Click="OnClose" Padding="16,8" />
        <Button x:Name="SaveButton" Content="Save" Click="OnSave" Padding="16,8"
                Background="{StaticResource AmberBrush}" Foreground="{StaticResource OnBrand}" FontWeight="SemiBold" />
      </StackPanel>
    </Border>

    <!-- Why Save refused, shown above the action row so it is visible however far the body has scrolled. -->
    <TextBlock x:Name="SaveErrorLine" DockPanel.Dock="Bottom" Margin="24,8,24,0" IsVisible="False"
               Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <!-- Each section is a free-standing block: the panel packs them into however many columns the
           current width fits, so nothing is padded out to match a neighbour's height. -->
      <controls:MasonryPanel Margin="24,24,24,20" MinColumnWidth="340" ColumnSpacing="16" RowSpacing="16">

        <StackPanel Spacing="8">
          <TextBlock Text="PRIVACY" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="SemiBold" LetterSpacing="2" />
          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <CheckBox x:Name="CrashToggle" Content="Send anonymous crash &amp; error reports"
                        Foreground="{StaticResource Ink}" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="App version, OS, and errors with stack traces, plus a random install id. Never your commander name, systems, journal contents, or user name / paths." />
              <TextBlock x:Name="StatusLine" Foreground="{StaticResource InkDim}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="DATA REPORTING" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="SemiBold" LetterSpacing="2" />
          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <CheckBox x:Name="EddnToggle" Content="Contribute anonymized data to EDDN"
                        Foreground="{StaticResource Ink}" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Uploads market, scan, and travel data to the community Elite Dangerous Data Network. The relay obfuscates your uploader id — no personal identity is shared." />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <CheckBox x:Name="InaraToggle" Content="Sync my commander to Inara"
                        Foreground="{StaticResource Ink}" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Sends your identity, credits, ranks, and travel to your Inara profile on session start, docking, and FSD jumps. Requires your personal Inara API key (Inara → Profile → API keys)." />
              <!-- Masked by default: keys get leaked through streams and screenshots, not local attackers. -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="InaraApiKey" PlaceholderText="Inara API key" PasswordChar="●"
                         Foreground="{StaticResource Ink}" Background="{StaticResource CardBg}" />
                <CheckBox x:Name="RevealApiKey" Grid.Column="1" Content="Show" Margin="10,0,0,0"
                          Foreground="{StaticResource InkDim}" IsCheckedChanged="OnRevealApiKeyChanged" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <CheckBox x:Name="RavenLookupToggle" Content="Look up shared colonisation projects on Raven Colonial"
                        Foreground="{StaticResource Ink}" IsCheckedChanged="OnRavenLookupChanged" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="When you dock at a construction site, the system name and market id are sent to Raven Colonial to find a shared project for it. Turn this off to keep colonisation lookups on this machine." />
              <CheckBox x:Name="ShareDeliveriesToggle" Content="Also share my deliveries with that project"
                        Foreground="{StaticResource Ink}" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Sends your commander NAME and what you delivered to Raven Colonial after each delivery. Its endpoint is unauthenticated: anyone can post under any name, and your deliveries are added to the project's totals as sent. If another tool (SrvSurvey, for example) also reports your deliveries to the same project, they will be counted twice. Needs the lookup above." />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="UPDATES" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="SemiBold" LetterSpacing="2" />
          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <CheckBox x:Name="AutoDownloadToggle" Content="Automatically download updates on startup"
                        Foreground="{StaticResource Ink}" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="When enabled, EDNexus will fetch the latest GitHub release asset for your platform and download it to your temp folder. Installation must still be performed by the user." />

              <!-- Wraps rather than clipping: the update line can be a long file name in a narrow column. -->
              <WrapPanel ItemSpacing="10" LineSpacing="4">
                <TextBlock Text="Version:" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionLine" Foreground="{StaticResource InkDim}" VerticalAlignment="Center" />
                <TextBlock Text="Update:" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="14,0,0,0" />
                <TextBlock x:Name="UpdateLine" Foreground="{StaticResource InkDim}" VerticalAlignment="Center" />
              </WrapPanel>

              <Button x:Name="CheckNowButton" Content="Check for updates now" Click="OnCheckNow"
                      Padding="10" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="MINING" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="SemiBold" LetterSpacing="2" />
          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="MIN VALUE TO CALL OUT (CR)" Foreground="{StaticResource Ink}" FontSize="12" />
              <TextBox x:Name="MiningThresholdBox" PlaceholderText="e.g. 50000" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="A prospected material — or deep-core motherlode — at or above this galactic-average price is called out on the mining card and rings a chime. Leave blank to turn the highlight off." />

              <CheckBox x:Name="MiningSpotAnnounceToggle" Content="Call out known planetary mining spots on arrival" Foreground="{StaticResource Ink}" />
              <TextBlock x:Name="MiningSpotsSummary" Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Whenever you refine a commodity at or above the value above from an SRV, EDNexus records where on the planet you mined it. Arriving in that system again speaks the spots worth mining. Needs voice callouts turned on under Overlay &amp; Voice." />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Dashboard layout — order, width and visibility per card. Bound to the live card list, so
             changes take effect on the dashboard behind this window immediately. -->
        <StackPanel x:Name="DashboardSection" Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="DASHBOARD" Foreground="{StaticResource AmberBrush}" FontSize="12"
                       FontWeight="SemiBold" LetterSpacing="2" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button x:Name="ExportLayoutButton" Content="Export…" Click="OnExportLayout"
                      Padding="10,4" FontSize="12"
                      ToolTip.Tip="Save this arrangement to a file you can carry to another machine" />
              <Button x:Name="ImportLayoutButton" Content="Import…" Click="OnImportLayout"
                      Padding="10,4" FontSize="12"
                      ToolTip.Tip="Load an arrangement exported from another machine" />
              <Button x:Name="ResetLayoutButton" Content="Reset" Click="OnResetLayout"
                      Padding="10,4" FontSize="12" ToolTip.Tip="Restore the shipped order and widths, and hand placement back to automatic packing" />
            </StackPanel>
          </Grid>
          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Drag a card by its title to move it to another column or position on the dashboard — that arrangement is saved. The arrows move a card within its own column. Until you move one, cards are packed automatically into as many columns as the window is wide; a wide card claims two of those columns, a narrow one claims one. Collapsing a card from its header is remembered too. Export carries only the layout — never your Inara key — so it is safe to sync or share." />
              <TextBlock x:Name="LayoutStatus" Foreground="{StaticResource AmberBrush}" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
              <!-- No inner scroller: the dialog scrolls as a whole now, and a nested scroll region
                   steals the wheel from the page it sits in. -->
              <ItemsControl x:Name="CardList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CardViewModel">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,3">
                      <Button Grid.Column="0" Content="▲" Padding="8,2" FontSize="11" MinWidth="30"
                              Click="OnMoveCardUp" Tag="{Binding Id}" ToolTip.Tip="Move up within its column" />
                      <Button Grid.Column="1" Content="▼" Padding="8,2" FontSize="11" MinWidth="30" Margin="4,0,0,0"
                              Click="OnMoveCardDown" Tag="{Binding Id}" ToolTip.Tip="Move down within its column" />
                      <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="{StaticResource Ink}" FontSize="13"
                                 VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="3" Content="{Binding WidthGlyph}" Padding="8,2" FontSize="11" MinWidth="34"
                              Command="{Binding ToggleWidthCommand}" ToolTip.Tip="Toggle narrow / wide" />
                      <CheckBox Grid.Column="4" Content="Show" Margin="10,0,0,0" Foreground="{StaticResource Ink}"
                                FontSize="12" IsChecked="{Binding IsVisible}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Overlay & voice — Phase 6. The overlay is Windows-only; elsewhere the toggle is harmless
             (IOverlay/IVoice degrade to no-ops) but left visible so the setting still round-trips. -->
        <StackPanel Spacing="8">
          <TextBlock Text="OVERLAY &amp; VOICE" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="SemiBold" LetterSpacing="2" />
          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <CheckBox x:Name="OverlayToggle" Content="Show in-game overlay" Foreground="{StaticResource Ink}" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="A small, click-through, always-on-top panel over the game (borderless/windowed) showing your next jump, fuel, bio signals on the current body, and any colonisation shortfall. Windows only — a no-op on other platforms." />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <CheckBox x:Name="VoiceToggle" Content="Speak callouts" Foreground="{StaticResource Ink}" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Announces fuel low, a completed exobiology scan, and a colonisation shopping-list item fully aboard. Windows only (SAPI) — a no-op on other platforms." />

              <TextBlock Text="VOICE" Foreground="{StaticResource Ink}" FontSize="12" />
              <ComboBox x:Name="VoiceNameCombo" HorizontalAlignment="Stretch" PlaceholderText="System default" />

              <TextBlock Text="VOLUME" Foreground="{StaticResource Ink}" FontSize="12" />
              <Slider x:Name="VoiceVolumeSlider" Minimum="0" Maximum="100" TickFrequency="10" />

              <TextBlock Text="CALLOUTS" Foreground="{StaticResource Ink}" FontSize="12" />
              <CheckBox x:Name="FuelLowToggle" Content="Fuel low" Foreground="{StaticResource Ink}" />
              <CheckBox x:Name="ScanCompleteToggle" Content="Scan complete" Foreground="{StaticResource Ink}" />
              <CheckBox x:Name="ShoppingListToggle" Content="Shopping-list item acquired" Foreground="{StaticResource Ink}" />

              <Button x:Name="TestVoiceButton" Content="Test voice" Click="OnTestVoice"
                      Padding="10" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Radio player — the on/off switch. Station, volume and mute live on the Space Radio card and
             the title-bar transport, and are saved as they change. -->
        <StackPanel Spacing="8">
          <TextBlock Text="RADIO PLAYER" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="SemiBold" LetterSpacing="2" />
          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <CheckBox x:Name="RadioToggle" Content="Enable the radio player" Foreground="{StaticResource Ink}" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Streams community and ambient space radio stations in the background. Turning this off stops playback and keeps the radio silent on the next launch. Pick a station, volume and mute from the Space Radio card or the title-bar controls; pressing play there turns the radio back on." />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Twitch — what viewers of the commander's stream can pull up over the video. Each section
             is opt-in: anything left unchecked is never put into the published payload at all, so it
             does not leave this machine. See extension/README.md for the viewer side. -->
        <StackPanel Spacing="8">
          <TextBlock Text="TWITCH" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="SemiBold" LetterSpacing="2" />

          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock x:Name="TwitchAccountLine" Foreground="{StaticResource Ink}" FontSize="13" TextWrapping="Wrap"
                         Text="Not signed in." />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Signing in opens your browser. EDNexus never sees your Twitch password or token — the backend service performs the handshake and hands back its own credential for this machine." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="TwitchLoginButton" Content="Sign in with Twitch" Click="OnTwitchLogin" Padding="12,7" />
                <Button x:Name="TwitchLogoutButton" Content="Sign out" Click="OnTwitchLogout" Padding="12,7" IsVisible="False" />
              </StackPanel>
              <TextBlock x:Name="TwitchAuthLine" Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <CheckBox x:Name="TwitchCardToggle" Content="Show my session to viewers" Foreground="{StaticResource Ink}"
                        IsCheckedChanged="OnTwitchCardToggled" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Publishes the sections below to your channel's EDNexus extension, where viewers can pull out a card over the stream and hide it again. Off while developer mode is on, so fabricated data never reaches your audience." />

              <TextBlock Text="WHAT VIEWERS CAN SEE" Foreground="{StaticResource Ink}" FontSize="12" Margin="0,4,0,0" />
              <CheckBox x:Name="TwitchCommanderToggle" Content="Commander name &amp; ranks" Foreground="{StaticResource Ink}" IsCheckedChanged="OnTwitchSectionToggled" />
              <CheckBox x:Name="TwitchCreditsToggle" Content="Credit balance" Foreground="{StaticResource Ink}" IsCheckedChanged="OnTwitchSectionToggled" />
              <CheckBox x:Name="TwitchShipToggle" Content="Ship, fuel &amp; hold" Foreground="{StaticResource Ink}" IsCheckedChanged="OnTwitchSectionToggled" />
              <CheckBox x:Name="TwitchLocationToggle" Content="System, body &amp; station" Foreground="{StaticResource Ink}" IsCheckedChanged="OnTwitchSectionToggled" />
              <CheckBox x:Name="TwitchCarrierToggle" Content="Fleet carrier &amp; booked jumps" Foreground="{StaticResource Ink}" IsCheckedChanged="OnTwitchSectionToggled" />
              <CheckBox x:Name="TwitchExobioToggle" Content="Exobiology progress" Foreground="{StaticResource Ink}" IsCheckedChanged="OnTwitchSectionToggled" />
              <CheckBox x:Name="TwitchMiningToggle" Content="Mining" Foreground="{StaticResource Ink}" IsCheckedChanged="OnTwitchSectionToggled" />
              <CheckBox x:Name="TwitchMissionsToggle" Content="Missions" Foreground="{StaticResource Ink}" IsCheckedChanged="OnTwitchSectionToggled" />
              <CheckBox x:Name="TwitchCargoToggle" Content="Cargo manifest" Foreground="{StaticResource Ink}" IsCheckedChanged="OnTwitchSectionToggled" />

              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Anything unchecked is never sent — it is left out of the payload entirely, not hidden after the fact." />
            </StackPanel>
          </Border>

          <!-- The preview answers the only question that really matters before going live: what
               exactly is about to be on screen. Built from the same mapper the publisher uses. -->
          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="WHAT VIEWERS WILL SEE NOW" Foreground="{StaticResource Ink}" FontSize="12"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="TwitchPreviewRefresh" Content="Refresh" Click="OnTwitchRefreshPreview"
                        Padding="10,4" FontSize="12" />
              </Grid>
              <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="12">
                <SelectableTextBlock x:Name="TwitchPreview" Foreground="{StaticResource InkDim}" FontSize="12"
                                     FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap"
                                     Text="Start the app with the game running to see a preview." />
              </Border>
              <TextBlock x:Name="TwitchPublishStatus" Foreground="{StaticResource InkDim}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="BACKEND SERVICE (EBS)" Foreground="{StaticResource Ink}" FontSize="12" />
              <TextBox x:Name="TwitchEbsBox" PlaceholderText="https://ednexus.signal-and-thread.com" Foreground="{StaticResource Ink}" Background="{StaticResource CardBg}" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Leave blank for the hosted service. Change it only if you run your own — it must match the EBS base URL configured on the extension in your Twitch dashboard. Changing this signs you out." />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Discord Rich Presence — a local IPC link to the commander's own Discord client. Applied
             live on Save: off disconnects, the privacy toggles re-push the presence immediately. -->
        <StackPanel Spacing="8">
          <TextBlock Text="DISCORD PRESENCE" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="SemiBold" LetterSpacing="2" />
          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <CheckBox x:Name="DiscordToggle" Content="Enable Discord Rich Presence" Foreground="{StaticResource Ink}"
                        IsCheckedChanged="OnDiscordToggleChanged" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Shows your ship, location, and activity on your Discord profile while EDNexus is running. EDNexus hands this to the Discord app on this machine, and Discord shares it with your friends and servers like any other game status. Hidden while developer mode is on." />

              <CheckBox x:Name="DiscordShowSystemToggle" Content="Show current star system name" Foreground="{StaticResource Ink}" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="When off, your presence reads &quot;In flight&quot; or &quot;Docked&quot; — no system, body, station, or carrier name, and no Inara link (Inara shows your location) — so you can't be stream-sniped or give away a fresh discovery." />

              <CheckBox x:Name="DiscordShowCommanderToggle" Content="Show commander identity (Inara link, ship ID)" Foreground="{StaticResource Ink}" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="When off, the &quot;View on Inara&quot; button (which carries your commander name) and your ship's ID are left out." />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Developer options — hidden entirely when the dev tools are stripped/disabled (FeatureFlags). -->
        <StackPanel x:Name="DevSection" Spacing="8" IsVisible="False">
          <TextBlock Text="DEVELOPER OPTIONS" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="SemiBold" LetterSpacing="2" />
          <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="16">
            <StackPanel Spacing="10">
              <CheckBox x:Name="DevModeToggle" Content="Enable developer mode" Foreground="{StaticResource Ink}" />
              <TextBlock Foreground="{StaticResource InkDim}" FontSize="12" TextWrapping="Wrap"
                         Text="Adds a 🎲 control to each dashboard card to fabricate random-but-valid state, plus &quot;Randomize all&quot; and &quot;Reset to live data&quot;. For testing only — this resets to off every launch and is not saved. While it is on, EDDN/Inara reporting is paused so fabricated data is never sent." />
              <Button x:Name="SimulateOverlayVoiceButton" Content="Simulate overlay &amp; voice callouts"
                      Click="OnSimulateOverlayVoice" Padding="10" HorizontalAlignment="Left"
                      ToolTip.Tip="Fabricates a low-fuel status, a completed exobiology scan, and a colonisation delivery — the three moments that trigger a voice callout — through the real event bus." />
            </StackPanel>
          </Border>
        </StackPanel>
      </controls:MasonryPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
