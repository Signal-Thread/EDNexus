<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EDNexus.App.Views.ConfirmInstallWindow"
        Title="Install update" Icon="/Assets/ednexus.png"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" Background="{StaticResource CardBg}">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock Text="Install downloaded update?" Foreground="{StaticResource AmberBrush}"
               FontSize="17" FontWeight="SemiBold" />
    <TextBlock Foreground="{StaticResource Ink}" TextWrapping="Wrap" FontSize="13" LineHeight="20"
               Text="EDNexus downloaded an update and checked it against the SHA-256 checksum published with the release. The checksum shows the file arrived intact; it does not prove who published it. Installing runs the file with administrator rights, and EDNexus will close. The app never runs installers without your confirmation." />
    <Border Background="{StaticResource SurfaceField}" CornerRadius="6" Padding="14">
      <StackPanel Spacing="6">
        <TextBlock Text="File" Foreground="{StaticResource InkDim}" FontSize="11" FontWeight="SemiBold" />
        <TextBlock x:Name="FilePath" Foreground="{StaticResource Ink}" FontSize="12" TextWrapping="Wrap" />
        <TextBlock Text="SHA-256 (verified)" Foreground="{StaticResource InkDim}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" />
        <TextBlock x:Name="Checksum" Foreground="{StaticResource Ink}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancel" Click="OnDecline" Padding="16,8" />
      <Button Content="Install" Click="OnEnable" Padding="16,8"
              Background="{StaticResource AmberBrush}" Foreground="{StaticResource OnBrand}" FontWeight="SemiBold" />
    </StackPanel>
  </StackPanel>
</Window>
