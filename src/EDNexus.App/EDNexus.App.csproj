<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Embeds the icon into EDNexus.App.exe (used by the shortcut / taskbar). -->
    <ApplicationIcon>..\..\assets\icons\ednexus.ico</ApplicationIcon>
    <!-- Overridable by CI: dotnet publish -p:Version=1.2.3 -->
    <Version Condition="'$(Version)' == ''">0.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window/taskbar icon, addressable as avares://EDNexus.App/Assets/ednexus.png -->
    <AvaloniaResource Include="..\..\assets\icons\ednexus-256.png" Link="Assets\ednexus.png" />
    <!-- The mining card's "worth mining" chime, addressable as avares://EDNexus.App/Assets/mining-alert.wav -->
    <AvaloniaResource Include="..\..\assets\sounds\mining-alert.wav" Link="Assets\mining-alert.wav" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EDNexus.Core\EDNexus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Sentry" Version="6.12.0" />
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
  </ItemGroup>

  <!--
    Native LibVLC runtime for the radio player. Windows/macOS ship the engine via these NuGet
    packages (harmless to reference from either build host — each only contributes its own
    runtimes/<rid> assets, which are filtered by target RID at publish time). Linux has no
    equivalent package and instead loads the system-installed libvlc (e.g. `apt install vlc` /
    `libvlc-dev`) at runtime — RadioPlayerService degrades to a reported error state rather than
    crashing when it's missing.
  -->
  <ItemGroup>
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" />
  </ItemGroup>

  <!--
    Sentry DSN is injected at release build time from a CI secret and baked into assembly metadata
    (read back by SentryConfig.ResolveDsn). It is NEVER committed to the repo. Local/dev builds leave
    it empty, so crash reporting stays disabled unless EDNEXUS_SENTRY_DSN is set at runtime.
      dotnet publish ... -p:SentryDsn=$SENTRY_DSN
  -->
  <PropertyGroup>
    <SentryDsn Condition="'$(SentryDsn)' == ''"></SentryDsn>
  </PropertyGroup>
  <ItemGroup Condition="'$(SentryDsn)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SentryDsn</_Parameter1>
      <_Parameter2>$(SentryDsn)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Debug-symbol + source upload for readable stack traces / release health. Runs ONLY when
    SENTRY_AUTH_TOKEN is present (i.e. the release workflow), so ordinary builds never upload.
    Override the slugs with -p:SentryOrg=... -p:SentryProject=... if they differ.
  -->
  <PropertyGroup Condition="'$(SENTRY_AUTH_TOKEN)' != ''">
    <SentryOrg Condition="'$(SentryOrg)' == ''">signal-thread-llc</SentryOrg>
    <SentryProject Condition="'$(SentryProject)' == ''">ednexus</SentryProject>
    <SentryUploadSymbols>true</SentryUploadSymbols>
    <SentryUploadSources>true</SentryUploadSources>
  </PropertyGroup>

</Project>
