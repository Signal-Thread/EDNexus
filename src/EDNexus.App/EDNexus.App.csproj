<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Embeds the icon into EDNexus.App.exe (used by the shortcut / taskbar). -->
    <ApplicationIcon>..\..\assets\icons\ednexus.ico</ApplicationIcon>
    <!-- Overridable by CI: dotnet publish -p:Version=1.2.3 -->
    <Version Condition="'$(Version)' == ''">0.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window/taskbar icon, addressable as avares://EDNexus.App/Assets/ednexus.png -->
    <AvaloniaResource Include="..\..\assets\icons\ednexus-256.png" Link="Assets\ednexus.png" />
    <!-- The mining card's "worth mining" chime, addressable as avares://EDNexus.App/Assets/mining-alert.wav -->
    <AvaloniaResource Include="..\..\assets\sounds\mining-alert.wav" Link="Assets\mining-alert.wav" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EDNexus.Core\EDNexus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Sentry" Version="6.12.1" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
  </ItemGroup>

  <!--
    Native LibVLC runtime for the radio player. Windows/macOS ship the engine via these NuGet
    packages. Linux has no equivalent package and instead loads the system-installed libvlc (e.g.
    `apt install vlc` / `libvlc-dev`) at runtime: RadioPlayerService degrades to a reported error state
    rather than crashing when it's missing.

    The packages are NOT filtered by target RID on their own: VideoLAN.LibVLC.Windows copies the x64, x86
    AND arm64 engines (about 100 MB each) next to the app whatever you publish, and VideoLAN.LibVLC.Mac
    drops a macOS libvlc.dylib (40 MB) into a Windows build. A win-x64 install was 541 MB, 180 MB of it
    VLC builds for CPUs it never runs on. So only the engine the target needs is referenced and enabled.
    RuntimeIdentifier is empty for a plain dev build, in which case the machine we are building on decides.

    Windows is x64 only: Elite Dangerous itself is an x64-only game (no ARM64 client, and its 32-bit client is
    long gone), and the installer publishes win-x64. On Windows on ARM an x64 process runs emulated and loads
    the x64 engine, so the x86 and arm64 engines are never wanted.
  -->
  <PropertyGroup>
    <_VlcWindows Condition="'$(RuntimeIdentifier)' != '' AND $(RuntimeIdentifier.StartsWith('win'))">true</_VlcWindows>
    <_VlcWindows Condition="'$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">true</_VlcWindows>
    <_VlcMac Condition="'$(RuntimeIdentifier)' != '' AND $(RuntimeIdentifier.StartsWith('osx'))">true</_VlcMac>
    <_VlcMac Condition="'$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('OSX'))">true</_VlcMac>

    <!-- Read by VideoLAN.LibVLC.Windows.targets: an unset value means "yes" there, so say no explicitly. -->
    <VlcWindowsX64Enabled Condition="'$(_VlcWindows)' == 'true'">true</VlcWindowsX64Enabled>
    <VlcWindowsX64Enabled Condition="'$(VlcWindowsX64Enabled)' == ''">false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" Condition="'$(_VlcWindows)' == 'true'" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" Condition="'$(_VlcMac)' == 'true'" />
  </ItemGroup>

  <!--
    SkiaSharp and HarfBuzzSharp ship their native debug symbols (libSkiaSharp.pdb is 80 MB, libHarfBuzzSharp.pdb
    20 MB) in the same runtimes/ folder as the DLLs, and a publish copies them to the install. Nothing at
    runtime reads them, and we do not symbolicate those native frames. EDNexus's own .pdb files stay.
  -->
  <Target Name="DropThirdPartyNativeSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' AND ('%(Filename)' == 'libSkiaSharp' OR '%(Filename)' == 'libHarfBuzzSharp')" />
    </ItemGroup>
  </Target>

  <!--
    Sentry DSN is injected at release build time from a CI secret and baked into assembly metadata
    (read back by SentryConfig.ResolveDsn). It is NEVER committed to the repo. Local/dev builds leave
    it empty, so crash reporting stays disabled unless EDNEXUS_SENTRY_DSN is set at runtime.
      dotnet publish ... -p:SentryDsn=$SENTRY_DSN
  -->
  <PropertyGroup>
    <SentryDsn Condition="'$(SentryDsn)' == ''"></SentryDsn>
  </PropertyGroup>
  <ItemGroup Condition="'$(SentryDsn)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SentryDsn</_Parameter1>
      <_Parameter2>$(SentryDsn)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Debug-symbol + source upload for readable stack traces / release health. Runs ONLY when
    SENTRY_AUTH_TOKEN is present (i.e. the release workflow), so ordinary builds never upload.
    Override the slugs with -p:SentryOrg=... -p:SentryProject=... if they differ.
  -->
  <PropertyGroup Condition="'$(SENTRY_AUTH_TOKEN)' != ''">
    <SentryOrg Condition="'$(SentryOrg)' == ''">signal-thread-llc</SentryOrg>
    <SentryProject Condition="'$(SentryProject)' == ''">ednexus</SentryProject>
    <SentryUploadSymbols>true</SentryUploadSymbols>
    <SentryUploadSources>true</SentryUploadSources>
  </PropertyGroup>

</Project>
