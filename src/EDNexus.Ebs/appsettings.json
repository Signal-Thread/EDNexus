{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Twitch": {
    "ClientId": "",
    "ClientSecret": "",
    "ExtensionId": "",
    "ExtensionSecret": "",
    "OutboundTokenLifetimeSeconds": 180,
    "OAuthRedirectUri": "https://ednexus.signal-and-thread.com/oauth/callback",
    "OAuthScopes": [ "user:read:email" ]
  },
  "Ebs": {
    "Port": 8787,
    "MaxStatePayloadBytes": 5000,
    "UpdateStateRateLimit": 1,
    "UpdateStateRateLimitWindowSeconds": 2,
    "OAuthSessionTtlMinutes": 10,
    "OAuthCodeTtlSeconds": 60,
    "TwitchTokenRefreshIntervalMinutes": 30,
    "TwitchTokenRefreshBufferMinutes": 60,
    "StorageProvider": "Sqlite",
    "DataDirectory": "data"
  }
}
