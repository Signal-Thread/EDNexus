# EDNexus EBS — container configuration.
#
#   cp src/EDNexus.Ebs/.env.example src/EDNexus.Ebs/.env
#   docker run --env-file src/EDNexus.Ebs/.env -p 127.0.0.1:8787:8787 ghcr.io/signal-thread-llc/ednexus-ebs:latest
#
# .env is git-ignored; .env.example is committed and must never contain a real secret.
# ASP.NET Core maps a "__" in an environment variable onto a ":" in configuration, so
# Twitch__ClientSecret sets Twitch:ClientSecret.

# ─── Twitch application (public identifiers) ──────────────────────────────────
# From the extension's page in the Twitch Developer Console. Both are public: the client id
# travels in OAuth URLs and the extension id is visible to every viewer.
#   ClientId    : the Twitch application that performs the OAuth login.
#   ExtensionId : the extension itself; sent as the Client-Id header of the PubSub call. For this
#                 project's deployment it is the same value as ClientId. Both are required.
Twitch__ClientId=du1kvc0ev8b442ct5rzx9ktr7dhvfz
Twitch__ExtensionId=du1kvc0ev8b442ct5rzx9ktr7dhvfz

# Optional: the numeric Twitch user id of the extension's OWNER account, sent as the user_id claim of
# the PubSub JWT (Twitch documents that claim as the owner's id). Leave unset unless PubSub publishing
# fails with 401/403 - see "Publish smoke test" in the README.
# Twitch__OwnerUserId=

# ─── Secrets — never commit these ─────────────────────────────────────────────
# ClientSecret    : pairs with the client id for the OAuth token exchange. A missing value fails
#                   login with Twitch's own "missing client secret".
# ExtensionSecret : base64, signs the JWT for the PubSub broadcast. A different value from the
#                   client secret. The service refuses to start unless this is valid base64 of at
#                   least 16 bytes (Twitch issues 32), and unless ClientSecret is set.
Twitch__ClientSecret=
Twitch__ExtensionSecret=

# ─── OAuth ────────────────────────────────────────────────────────────────────
# Must match a redirect URL registered on the Twitch application, character for character —
# scheme included. Twitch rejects the login outright on any mismatch.
Twitch__OAuthRedirectUri=https://ednexus.signal-and-thread.com/oauth/callback

# Scopes requested at login. The default (user:read:email) is the minimum needed to identify the
# broadcaster. The configuration binder APPENDS to that default rather than replacing it, so a scope
# listed here is added and the default cannot be removed through configuration. The service drops
# duplicates before asking Twitch.
# Twitch__OAuthScopes__0=user:read:email

# ─── Service ──────────────────────────────────────────────────────────────────
# Port Kestrel binds when ASPNETCORE_URLS is unset. Behind a TLS-terminating proxy, leave this
# as plain HTTP and let the proxy hold the certificate.
Ebs__Port=8787
ASPNETCORE_URLS=http://0.0.0.0:8787

# Twitch drops any PubSub message over 5 KiB; the service refuses one first, with a 413. Values above
# 5120 are refused at startup. Request bodies over Ebs__MaxRequestBodyBytes (default 16384) get a 413.
Ebs__MaxStatePayloadBytes=5000

# Per-channel throttle on POST /api/update-state. The desktop client publishes at most once every
# five seconds, so this leaves headroom.
Ebs__UpdateStateRateLimit=1
Ebs__UpdateStateRateLimitWindowSeconds=2

# Extra browser origins allowed to read GET /api/initial-state/{channelId}. Twitch's own
# *.ext-twitch.tv is always allowed, so this is only for the Developer Rig or a local asset server.
# PRODUCTION: LEAVE THIS UNSET. Every origin listed is another website that can read your viewers'
# card data from a browser.
# Ebs__AdditionalAllowedFrontendOrigins__0=https://localhost:8080

# Behind the TLS proxy, whose X-Forwarded-For is trusted so rate limits are per viewer. By default any
# loopback/private-range peer counts as the proxy; narrow it to your compose network or proxy IP.
# Setting either replaces the defaults.
# Ebs__TrustedProxyNetworks__0=172.18.0.0/16
# Ebs__TrustedProxies__0=172.18.0.2

# Per-client-IP limits: GET /api/initial-state (every viewer's page load) and the four /oauth/* routes.
# Ebs__InitialStateRateLimit=60
# Ebs__InitialStateRateLimitWindowSeconds=10
# Ebs__OAuthRateLimit=30
# Ebs__OAuthRateLimitWindowSeconds=60

# How long a commander has to finish the Twitch consent page, and how long the one-time code
# handed back to the desktop app stays redeemable.
Ebs__OAuthSessionTtlMinutes=10
Ebs__OAuthCodeTtlSeconds=60

# How often broadcaster Twitch grants are refreshed, and how far ahead of expiry.
Ebs__TwitchTokenRefreshIntervalMinutes=30
Ebs__TwitchTokenRefreshBufferMinutes=60

# Where broadcaster tokens, encrypted Twitch grants and last published channel state are persisted.
# The image already sets this to /data; mount a volume there. Losing it logs every broadcaster out.
# Ebs__DataDirectory=/data
# Keep the Data Protection key ring on a separate mount for real separation (default: <DataDirectory>/keys).
# docker-compose.yml already sets this to /keys on its own volume; an existing ring is moved there on start.
# Ebs__DataProtectionKeysDirectory=/keys

# Oldest last-published card GET /api/initial-state still serves, in hours (0 = no limit; 1-11 is
# refused). Bounds how long a card stays public if the desktop app's clear never reaches the EBS: the
# desktop re-sends a live card every 10 minutes, so a live card never gets near it.
Ebs__ChannelStateMaxAgeHours=24
